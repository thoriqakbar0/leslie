{
  "name": "leslie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http-get://127.0.0.1:5173 && LESLIE_RENDERER_URL=http://127.0.0.1:5173 electron electron/main.mjs\"",
    "dev:web": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "start": "electron electron/main.mjs",
    "preview": "vite preview",
    "test:app": "node --test tests/timer-history.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "agentation": "^3.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "wait-on": "^8.0.4"
  }
}
